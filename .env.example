# ID de la carpeta de Google Drive con la bibliografía
# (lo encontrás en la URL: drive.google.com/drive/folders/ESTE_ES_EL_ID)
DRIVE_FOLDER_ID=tu_folder_id_aqui

# Gmail: tu dirección y una contraseña de aplicación
# (no uses tu contraseña normal; generá una en: myaccount.google.com/apppasswords)
GMAIL_USER=tu@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# A dónde llegan los apuntes (puede ser el mismo que GMAIL_USER)
EMAIL_TO=tu@gmail.com

# Rutas a los archivos de credenciales de Google (opcionales, defaults abajo)
# GOOGLE_CREDENTIALS_PATH=credentials.json
# GOOGLE_TOKEN_PATH=token.json
